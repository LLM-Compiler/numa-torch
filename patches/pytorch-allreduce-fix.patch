+class _NumaAllReduceLine(DeferredLineBase):
+    """Emit one line of a cross-socket all-reduce only if the reduced tensor
+    is actually read afterwards -- either by a non-NUMA consumer of ``name``
+    (tracked in ``_numa_reassemble_consumed``) or by a downstream NUMA kernel
+    that reads one of the post-reduce per-socket re-clones in
+    ``reclone_names`` (tracked in ``_numa_reclone_consumed``). If neither
+    holds, the whole reduction is dead and is elided at flush time.
+    """
+
+    def __init__(
+        self,
+        line: str,
+        name: str,
+        consumed_set: "Set[str]",
+        reclone_names: "List[str]",
+        reclone_consumed: "Set[str]",
+    ) -> None:
+        super().__init__(line)
+        self.name = name
+        self._consumed_set = consumed_set
+        self._reclone_names = reclone_names
+        self._reclone_consumed = reclone_consumed
+
+    def _is_live(self) -> bool:
+        if self.name in self._consumed_set:
+            return True
+        return any(n in self._reclone_consumed for n in self._reclone_names)
+
+    def __call__(self) -> Optional[str]:
+        return self.line if self._is_live() else None
+
+    def _new_line(self, line: str) -> "_NumaAllReduceLine":
+        return _NumaAllReduceLine(
+            line,
+            self.name,
+            self._consumed_set,
+            self._reclone_names,
+            self._reclone_consumed,
+        )
+
+
+class _NumaGraphOutputCopyLine(DeferredLineBase):
+    """Reconcile a replicated per-socket result that is also a graph output.
+
+    The two reconciliation paths cover terminal partial sums (all-reduce) and
+    intermediate activations (stay socket-local, forwarded to the next local
+    kernel). A replicated result that is returned from the graph fits neither:
+    it has no downstream local kernel, so nothing would ever write the buffer
+    the caller receives, and the model returns unwritten memory.
+
+    Every socket holds a COMPLETE copy of a replicated result (Algorithm 3), so
+    a single copy from node 0 reconciles it. Summing would scale the value by
+    the socket count. Emitted only if ``name`` really is a graph output at
+    flush time, when ``V.graph.graph_outputs`` is final.
+    """
+
+    def __init__(self, line: str, name: str) -> None:
+        super().__init__(line)
+        self.name = name
+
+    def __call__(self) -> Optional[str]:
+        return self.line if self.name in V.graph.get_output_names() else None
+
+    def _new_line(self, line: str) -> "_NumaGraphOutputCopyLine":
+        return _NumaGraphOutputCopyLine(line, self.name)
+
+
